{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/health",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/2024K/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/cells/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/logo.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/accounts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "nitsri.dhe.org.in" }],
      "destination": "https://www.dhe.org.in/nitsri",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nitsri.dhe.org.in" }],
      "destination": "https://www.dhe.org.in/nitsri",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "nitkkr.dhe.org.in" }],
      "destination": "https://www.dhe.org.in/nitkkr",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nitkkr.dhe.org.in" }],
      "destination": "https://www.dhe.org.in/nitkkr",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "nitj.dhe.org.in" }],
      "destination": "https://www.dhe.org.in/nitj",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nitj.dhe.org.in" }],
      "destination": "https://www.dhe.org.in/nitj",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "iitr.dhe.org.in" }],
      "destination": "https://www.dhe.org.in/iitrpr",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "iitr.dhe.org.in" }],
      "destination": "https://www.dhe.org.in/iitrpr",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "iitrpr.dhe.org.in" }],
      "destination": "https://www.dhe.org.in/iitrpr",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "iitrpr.dhe.org.in" }],
      "destination": "https://www.dhe.org.in/iitrpr",
      "permanent": true
    }
  ]
}
