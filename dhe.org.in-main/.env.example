# Brevo: v3 API key for receipt emails on Vercel (required)
BREVO_API_KEY=xkeysib-...
SMTP_FROM=director@dhe.org.in
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=xsmtpsib-...

NEXT_PUBLIC_SITE_URL=https://www.dhe.org.in
NEXT_PUBLIC_NOTICE_ADMIN_EMAILS=

